DATABASE_URL="file:./dev.db"

PORT=3000

# Shared secret between the extension and this API.
# Development only. Production should use real per-user authentication
# instead of distributing a permanent shared secret.
BACKEND_API_KEY=replace-with-a-long-random-string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 32-byte key, base64-encoded, or any long secret. Used for AES-256-GCM.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Application safety limits. These are not Gmail's provider limits.
# Lower them if you want to send more slowly. Do not raise them to evade Gmail.
EMAIL_SEND_INTERVAL_MS=10000
MAX_EMAILS_PER_HOUR=50
MAX_EMAILS_PER_DAY=200

# Public base URL used for unsubscribe links.
APP_BASE_URL=http://localhost:3000

# Chrome extension origin. Leave blank to allow any chrome-extension:// origin
# during unpacked local development. Set the exact origin in production.
EXTENSION_ORIGIN=

# Server-only. The extension cannot override this.
# false means an address that was successfully emailed is never queued again.
ALLOW_REPEAT_CONTACT=false

INCLUDE_UNSUBSCRIBE_LINK=true

# The API process sends queued campaign email. Set false only when a separate `npm run worker` process is running.
RUN_WORKER_IN_SERVER=true
