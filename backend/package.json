{
  "name": "npm-outreach-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Outreach API for the npm Public Email Collector extension",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run build --prefix ../shared && tsx watch src/server.ts",
    "build": "npm run build --prefix ../shared && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "npm run build --prefix ../shared && tsx src/workers/index.ts",
    "worker:prod": "node dist/workers/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "rm -rf node_modules/@npm-outreach/shared && mkdir -p node_modules/@npm-outreach && ln -sfn ../../../shared node_modules/@npm-outreach/shared",
    "lint": "eslint src test --ext .ts",
    "typecheck": "npm run build --prefix ../shared && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build --prefix ../shared && vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@npm-outreach/shared": "file:../shared",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "googleapis": "^144.0.0",
    "pg-boss": "^9.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^18.19.68",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
