{
  "manifest_version": 3,
  "name": "npm Public Email Collector",
  "version": "3.0.0",
  "description": "Collects public npm maintainer emails and queues reviewed outreach through a backend Gmail integration.",
  "permissions": ["downloads", "storage", "tabs", "alarms"],
  "host_permissions": [
    "https://registry.npmjs.org/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open npm Public Email Collector"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
